{
  "name": "rungis",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "watch": "node --watch backend/src/server.js",
    "dev": "npm-run-all -p dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run watch",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "test:functional": "playwright test",
    "perf:smoke": "k6 run performance/k6/http-smoke.js",
    "perf:websocket": "k6 run performance/k6/websocket-smoke.js",
    "perf:load": "k6 run performance/k6/api-load.js",
    "perf:test": "npm-run-all -s perf:smoke perf:websocket"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/k6": "^2.0.0",
    "npm-run-all": "^4.1.5"
  }
}

{
  "name": "rungis",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "watch": "node --watch backend/src/server.js",
    "dev": "npm-run-all -p dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run watch",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
